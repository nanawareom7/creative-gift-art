{
  "info": {
    "_postman_id": "creative-gift-art-api",
    "name": "Creative Gift Art API",
    "description": "Complete API collection for Creative Gift Art backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/../health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@creativegiftart.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Get Active Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories?active=true",
              "query": [{ "key": "active", "value": "true" }]
            }
          }
        },
        {
          "name": "Get Category by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/:id",
            "variable": [{ "key": "id", "value": "CATEGORY_ID_HERE" }]
          }
        },
        {
          "name": "Get Category by Slug",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/wedding"
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Category\",\n  \"description\": \"Description of the category\",\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/categories/:id",
            "variable": [{ "key": "id", "value": "CATEGORY_ID_HERE" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"description\": \"Updated description\",\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/categories/:id",
            "variable": [{ "key": "id", "value": "CATEGORY_ID_HERE" }]
          }
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "Get All Templates",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates?page=1&limit=12&sort=latest",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" },
                { "key": "sort", "value": "latest" }
              ]
            }
          }
        },
        {
          "name": "Get Templates - Popular Sort",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates?sort=popular",
              "query": [{ "key": "sort", "value": "popular" }]
            }
          }
        },
        {
          "name": "Get Templates - Filter by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates?category=wedding",
              "query": [{ "key": "category", "value": "wedding" }]
            }
          }
        },
        {
          "name": "Get Templates - Featured Only",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates?featured=true",
              "query": [{ "key": "featured", "value": "true" }]
            }
          }
        },
        {
          "name": "Get Featured Templates",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/templates/featured"
          }
        },
        {
          "name": "Search Templates",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates/search?q=wedding",
              "query": [{ "key": "q", "value": "wedding" }]
            }
          }
        },
        {
          "name": "Get Template by Slug",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/templates/royal-wedding-invitation"
          }
        },
        {
          "name": "Create Template",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/templates",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Royal Wedding Invitation\",\n  \"category\": \"CATEGORY_ID_HERE\",\n  \"youtubeLink\": \"https://youtube.com/shorts/xxxxx\",\n  \"description\": \"Luxury wedding invitation template with royal design\",\n  \"featured\": true,\n  \"tags\": [\"royal\", \"luxury\", \"traditional\", \"wedding\"]\n}"
            }
          }
        },
        {
          "name": "Update Template",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/templates/:id",
            "variable": [{ "key": "id", "value": "TEMPLATE_ID_HERE" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Template Title\",\n  \"featured\": false,\n  \"tags\": [\"updated\", \"tags\"]\n}"
            }
          }
        },
        {
          "name": "Delete Template",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/templates/:id",
            "variable": [{ "key": "id", "value": "TEMPLATE_ID_HERE" }]
          }
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload Template Image",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/upload/template-image",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "/path/to/image.jpg"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Uploaded Image",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/upload/:filename",
            "variable": [{ "key": "filename", "value": "template-uuid.jpg" }]
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/dashboard/stats"
          }
        }
      ]
    }
  ]
}
