# =============================================
# CREATIVE GIFT ART - BACKEND ENVIRONMENT
# =============================================

# Server
NODE_ENV=production
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://creativegiftart:Supercell1@cluster0.lepttvh.mongodb.net/creativegiftart?retryWrites=true&w=majority&appName=Cluster0

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
